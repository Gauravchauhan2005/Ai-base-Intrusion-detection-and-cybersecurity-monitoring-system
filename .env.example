# ==============================================================================
# IDS Platform Environment Configuration
# ==============================================================================

# Backend & Database
DATABASE_URL=postgresql://ids_user:ids_password@localhost:5432/ids_db
# For SQLite local fallback when Postgres is not running:
# DATABASE_URL=sqlite:///./ids_local.db

# Streaming Backend: "redis", "kafka", or "memory"
STREAM_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
STREAM_TOPIC=network_traffic_stream
CONSUMER_GROUP=ids_inference_group

# Model Artifacts Path
MODEL_DIR=ml/models
MODEL_VERSION=v1.0.0

# Inference & Alerting Thresholds
ANOMALY_THRESHOLD=0.0
ALERT_DEDUPLICATION_WINDOW_SEC=5
CRITICAL_CONFIDENCE_THRESHOLD=0.85
HIGH_CONFIDENCE_THRESHOLD=0.70

# Traffic Simulation
REPLAY_RATE_EPS=25
BURST_INTERVAL_SEC=30

# Frontend Next.js Public Endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live-stream
